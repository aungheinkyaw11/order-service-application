# Local development only. Copy this file to .env before starting Compose.
POSTGRES_DB=orders
POSTGRES_USER=orders
POSTGRES_PASSWORD=orders

DATABASE_URL=postgresql://orders:orders@postgres:5432/orders
NATS_URL=nats://nats:4222
NATS_STREAM=ORDERS
NATS_SUBJECT=orders.created
NATS_CONSUMER=orders-worker

LOG_LEVEL=INFO
PROCESSING_DELAY_SECONDS=2

# Optional tuning. The application already uses these defaults when omitted.
# DEPENDENCY_CONNECT_TIMEOUT_SECONDS=5
# DEPENDENCY_COMMAND_TIMEOUT_SECONDS=10
# SHUTDOWN_TIMEOUT_SECONDS=10
